# Local secrets - never commit API keys. Mirrors what the firmware will
# eventually store in NVS (set once via the WiFi config page).
demo/secrets.local.json

# PlatformIO's whole build/dependency cache - regenerated from platformio.ini's
# lib_deps by any `pio run`, none of it is this project's own code. Previously
# only firmware/.pio/build was excluded here, which left ~830 vendored
# third-party library files (firmware/.pio/libdeps) tracked by mistake.
firmware/.pio/

# Python bytecode cache (demo/) - was tracked by mistake for the same reason.
__pycache__/
*.pyc

# Local AI-agent working log - kept on disk and edited locally, but not
# meant to be part of the public repo. Fully purged from history (not just
# excluded going forward) via a git filter-repo pass.
CLAUDE.md
